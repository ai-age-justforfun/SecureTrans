# ============================================================
# SecureTrans 测试环境配置
# 用途：本地开发 / 测试服务器验证
# 特点：本地文件系统 + Flask 自带服务器，无需 NAS/gunicorn/nginx
# 使用：复制为 .env，然后 python app.py
# ============================================================

# 部署模式：testing（默认）/ production
DEPLOY_MODE=testing

# 数据目录（数据库、日志）— 本地相对路径
SECURETRANS_DATA=./data

# 存储根目录 — 测试环境用本地磁盘，不需要 NAS
# staging/external/archive 都在同一文件系统，os.rename 0拷贝
NAS_ROOT=./nas

# Flask 安全密钥 — 测试环境用固定值，生产环境务必修改
SECRET_KEY=securetrans-testing-secret-key-change-in-production

# 上传文件大小上限（1GB）
MAX_CONTENT_LENGTH=838860800

# 服务监听
HOST=0.0.0.0
PORT=8000

# 调试模式（测试环境可开 true，生产环境必须 false）
FLASK_DEBUG=true

# 重置密码默认值（admin 在用户管理中重置密码时使用，可修改）
RESET_PASSWORD=Init@123456

# 免审批总开关（默认关闭；开启后还需逐个启用特征码规则才生效，全为模板）
AUTO_APPROVAL_ENABLED=false
# external 文件默认过期天数（7天产品默认；与系统配置 default_expiry_days 单一来源，界面修改会写回此处）
EXTERNAL_EXPIRY_DAYS=7

# ============================================================
# AD/LDAP 配置 — 测试环境默认关闭，用本地用户 admin/Admin@123
# 如需测试 AD 认证，设为 true 并配置以下参数
# ============================================================
AD_ENABLED=false
AD_HOST=ldap://dc01.company.com:389
AD_DOMAIN=company.com
AD_BASE_DN=DC=company,DC=com
AD_BIND_DN=
AD_BIND_PASSWORD=
