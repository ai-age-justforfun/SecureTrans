# ============================================================
# SecureTrans 生产环境配置
# 用途：封闭数据中心正式部署
# 特点：NAS 存储 + gunicorn WSGI + nginx 反向代理 + systemd
# 使用：复制为 .env，用 gunicorn app:app 启动（不要用 python app.py）
# ============================================================

# 部署模式：production
DEPLOY_MODE=production

# 数据目录（数据库、日志）— 生产环境用绝对路径
SECURETRANS_DATA=/opt/securetrans/data

# 存储根目录 — 生产环境必须指向 NAS 挂载路径
# 关键：staging/external/archive 必须在同一个文件系统，os.rename 才能 0拷贝
# 示例：NFS 挂载 /mnt/nas/securetrans
NAS_ROOT=/mnt/nas/securetrans

# Flask 安全密钥 — 生产环境务必修改为随机字符串（至少32位）
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars

# 上传文件大小上限（1GB，nginx 也需配置 client_max_body_size 1G）
MAX_CONTENT_LENGTH=1073741824

# 服务监听 — gunicorn 监听 127.0.0.1:8000，nginx 反向代理对外
HOST=127.0.0.1
PORT=8000

# 调试模式 — 生产环境必须 false
FLASK_DEBUG=false

# external 文件默认过期天数
EXTERNAL_EXPIRY_DAYS=30

# ============================================================
# AD/LDAP 配置 — 生产环境启用，与 sssd 兼容（都走 LDAP 协议）
# ============================================================
AD_ENABLED=true
AD_HOST=ldap://dc01.company.com:389
AD_DOMAIN=company.com
AD_BASE_DN=DC=company,DC=com
AD_BIND_DN=
AD_BIND_PASSWORD=
