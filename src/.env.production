# ============================================================
# SecureTrans 生产环境配置
# 用途：封闭数据中心正式部署
# 特点：NAS 存储 + gunicorn WSGI + nginx 反向代理 + systemd
# 使用：复制为 .env，用 gunicorn app:app 启动（不要用 python app.py）
# ============================================================

# 部署模式：production
DEPLOY_MODE=production
# 发布阶段：alpha=自测 / beta=内部测试 / rtm=内部使用 / release=正式发布（页面/健康检查显示 vX.Y.Z-stage）
APP_STAGE=alpha

# 数据目录（数据库、日志）— 生产环境用绝对路径
SECURETRANS_DATA=/opt/securetrans/data

# 存储根目录 — 生产环境必须指向 NAS 挂载路径
# 关键：staging/external/archive 必须在同一个文件系统，os.rename 才能 0拷贝
# 示例：NFS 挂载 /mnt/nas/securetrans
NAS_ROOT=/mnt/nas/securetrans

# Flask 安全密钥 — 生产环境务必修改为随机字符串（至少32位）
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars

# 上传文件大小上限（v2.2.24+ 统一口径：MAX_FILE_SIZE_MB 为单文件上限，默认 800）
# MAX_CONTENT_LENGTH 由程序自动计算 = 文件上限 + 1MB（multipart 封装余量），禁止手工配置
# 运行时以系统配置 max_file_size_mb 为唯一权威——界面保存即生效、不再写回 .env，此值仅作首次部署播种
# 旧 .env 若仍有 MAX_CONTENT_LENGTH=838860800：文件上限自动按该值-1MB 兼容（799MB），建议用 infra/env-refresh.sh 刷新
MAX_FILE_SIZE_MB=800

# 服务监听 — gunicorn 监听 127.0.0.1:8000，nginx 反向代理对外
# HOST=0.0.0.0 监听全部网卡（单网卡 alpha 内测推荐；应用层 INTERNAL_CIDRS 识别内外网隔离）
# 双网卡物理隔离：改 HOST=<内网IP>，外网卡不监听 8000（无需 Nginx 即内外网隔离）
HOST=0.0.0.0
PORT=8000

# 调试模式 — 生产环境必须 false
FLASK_DEBUG=false

# 重置密码默认值（admin 在用户管理中重置密码时使用，可修改）
RESET_PASSWORD=Init@123456

# 免审批总开关（默认关闭；开启后还需逐个启用特征码规则才生效，全为模板）
AUTO_APPROVAL_ENABLED=false
# external 文件默认过期天数（7天产品默认；运行时以系统配置 default_expiry_days 为唯一权威——界面保存即生效、不再写回 .env，此值仅作首次部署播种）
EXTERNAL_EXPIRY_DAYS=7

# ============================================================
# 网络面配置（单网卡 / 双网卡部署）
# NETWORK_MODE: single（单网卡+防火墙放行内外网同一地址，按网段识别内外网）
#               / dual（双网卡，Nginx 分别绑定内网/外网网卡 IP）
# INTERNAL_CIDRS: 内网网段（逗号分隔 CIDR），单网卡模式据此识别内外网；
#                 直连(无Nginx)场景下应用层也据此兜底识别；留空则不做网段识别
# ============================================================
NETWORK_MODE=single
INTERNAL_CIDRS=10.10.10.0/24,10.10.30.0/24

# ============================================================
# AD/LDAP 配置 — 生产环境启用，与 sssd 兼容（都走 LDAP 协议）
# ============================================================
AD_ENABLED=true
AD_HOST=ldap://dc01.company.com:389
AD_DOMAIN=company.com
AD_BASE_DN=DC=company,DC=com
AD_BIND_DN=
AD_BIND_PASSWORD=
# AD 属性字段（默认值=AD 标准属性，通常无需修改；企业 AD 定制字段时在此调整）
AD_USER_FIELD=sAMAccountName
AD_DISPLAY_FIELD=displayName
AD_MAIL_FIELD=mail
AD_GROUP_FIELD=memberOf
