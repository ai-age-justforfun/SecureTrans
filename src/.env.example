# SecureTrans 环境配置示例
# 复制为 .env 并修改实际值

# 数据目录（数据库、日志）
SECURETRANS_DATA=./data

# 存储根目录（必须是单文件系统，os.rename 才能 0拷贝）
# 生产环境指向 NAS 挂载路径，如 /mnt/nas 或 D:\nas
NAS_ROOT=./nas

# Flask 安全密钥（生产环境务必修改为随机字符串）
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars

# 上传文件大小上限（v2.2.24+ 统一口径：单文件上限 MB，默认 800；请求体限制自动+1MB，勿配 MAX_CONTENT_LENGTH）
MAX_FILE_SIZE_MB=800

# 服务监听
HOST=0.0.0.0
PORT=8000

# 调试模式（生产环境设 false）
FLASK_DEBUG=false

# 重置密码默认值（admin 在用户管理中重置密码时使用，可修改）
RESET_PASSWORD=Init@123456

# 免审批总开关（默认关闭；开启后还需逐个启用特征码规则才生效，全为模板）
AUTO_APPROVAL_ENABLED=false
# external 文件默认过期天数（到期后 os.rename 到 archive）
EXTERNAL_EXPIRY_DAYS=7

# AD/LDAP 配置（直接 LDAP 绑定，与 sssd 兼容，互不干扰）
# 设为 true 后，本地用户认证失败时自动尝试 AD 认证
AD_ENABLED=false
# AD 服务器地址，支持 ldap:// / ldaps:// 前缀和端口
AD_HOST=ldap://dc01.company.com:389
# AD 域名（用于构造 UPN：username@AD_DOMAIN）
AD_DOMAIN=company.com
# 用户搜索基准 DN（查询用户信息时使用）
AD_BASE_DN=DC=company,DC=com
# 服务账户（可选，当前实现用用户直接绑定，不需要服务账户）
AD_BIND_DN=CN=svc_ldap,OU=Service,DC=company,DC=com
AD_BIND_PASSWORD=your-password
