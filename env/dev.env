# ============================================================
# SecureTrans 测试环境配置
# 用途：本地开发 / 测试服务器验证
# 特点：本地文件系统 + Flask 自带服务器，无需 NAS/gunicorn/nginx
# 使用：复制为 .env，然后 python app.py
# ============================================================

# 部署模式：testing（默认）/ production
DEPLOY_MODE=testing
# 发布阶段：alpha=自测 / beta=内部测试 / rtm=内部使用 / release=正式发布（页面/健康检查显示 vX.Y.Z-stage）
ENV_ROLE=test
APP_STAGE=beta

# 数据目录（数据库、日志）— 本地相对路径
SECURETRANS_DATA=./data

# 存储根目录 — 测试环境用本地磁盘，不需要 NAS
# staging/external/archive 都在同一文件系统，os.rename 0拷贝
NAS_ROOT=./nas

# Flask 安全密钥 — 测试环境用固定值，生产环境务必修改
SECRET_KEY=securetrans-testing-secret-key-change-in-production

# 上传文件大小上限（1GB）
MAX_FILE_SIZE_MB=800
TEMP_FILE_HOURS=24  # 未提交临时文件保留时长（小时），超时系统回收直接删除不归档

# 服务监听
HOST=0.0.0.0
PORT=8000

# 调试模式（测试环境可开 true，生产环境必须 false）
FLASK_DEBUG=true

# external 文件默认过期天数
EXTERNAL_EXPIRY_DAYS=7

# ============================================================
# AD 模拟开关（12-Factor 三环境一体化，ADR-016）
#   AD_MOCK_MODE=true  : 开发/测试环境——AD 搜索与登录走内置模拟目录（MOCK_AD_USERS，不触网），
#                        用于全量自动化回归；与生产典型 AD 数据（脱敏）一致。
#   AD_MOCK_MODE=false : 生产环境——直连真实 AD（SSSD/LDAP 同源兼容）。
# ============================================================
AD_MOCK_MODE=true

# ============================================================
# AD/LDAP 配置 — 测试环境默认关闭，用本地用户 admin/Admin@123
# 如需测试 AD 认证，设为 true 并配置以下参数
# ============================================================
AD_ENABLED=false
AD_HOST=ldap://dc01.company.com:389
AD_DOMAIN=company.com
AD_BASE_DN=DC=company,DC=com
AD_BIND_DN=
AD_BIND_PASSWORD=
RESET_PASSWORD=Init@123456
AUTO_APPROVAL_ENABLED=false

# ============================================================
# 飞书通知（ADR-051 旁路通道 / ADR-052 网关边界 / ADR-054 独立配置域）
#   SecureTrans 本机零出网：通知一律发往单向出网网关，由网关调飞书开放平台。
#   运行期以 SQLite feishu_config 为准（本段仅首次播种/回退）；管理页"飞书通知"可改、即时生效。
#   地址可写 FEISHU_NOTIFY_URL（完整 URL）或 FEISHU_GATEWAY_HOST/PORT/PATH（IP 显式）；
#   App Secret 不在此处、不在业务机 —— 只存网关 .env（ADR-052）。
#   dev/test 环境指向测试桩（tests/test_api.py 启动的 stub），用真实 HTTP 验证链路。
#   关闭（FEISHU_NOTIFY_ENABLED=false）时通知记 skipped，业务照常。
# ============================================================
FEISHU_NOTIFY_ENABLED=true
FEISHU_NOTIFY_URL=http://127.0.0.1:18099/notify
FEISHU_NOTIFY_TOKEN=test-notify-token
FEISHU_NOTIFY_TIMEOUT=3
FEISHU_NOTIFY_APP_URL=http://127.0.0.1:8000
# 可选：分字段配置（留空则用 FEISHU_NOTIFY_URL；PORT/PATH 有默认 8090、/notify）
FEISHU_GATEWAY_HOST=
FEISHU_GATEWAY_PORT=
FEISHU_GATEWAY_PATH=
# 可选：App ID 仅展示/核对（Secret 严禁写入本文件）
FEISHU_APP_ID=
