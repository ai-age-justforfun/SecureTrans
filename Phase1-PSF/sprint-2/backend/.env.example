# SecureTrans 环境配置示例
# 复制为 .env 并修改实际值

# 数据目录（数据库、日志、临时文件）
SECURETRANS_DATA=./data

# NAS 挂载路径（archive/internal/external 三目录在此下）
NAS_MOUNT=./data/nas

# JWT/Token 密钥（生产环境务必修改为随机字符串）
SECRET_KEY=change-this-to-a-random-secret-key

# Token 过期时间（小时）
TOKEN_EXPIRE_HOURS=24

# 服务监听
HOST=0.0.0.0
PORT=8000

# AD/LDAP 配置（PMF 阶段接入，先设 false 用本地用户）
AD_ENABLED=false
AD_HOST=dc01.company.com
AD_BASE_DN=DC=company,DC=com
AD_BIND_DN=CN=svc_ldap,OU=Service,DC=company,DC=com
AD_BIND_PASSWORD=your-password
