# ============================================================
# SecureTrans 生产环境配置
# 复制到 backend-flask/.env 并根据实际环境修改
# ============================================================

# 数据目录（数据库、日志）— 使用绝对路径
SECURETRANS_DATA=/opt/securetrans/backend-flask/data

# 存储根目录（必须是单文件系统，os.rename 才能 0拷贝）
# 生产环境指向 NAS 挂载路径，如 /mnt/nas/securetrans
NAS_ROOT=/mnt/nas/securetrans

# Flask 安全密钥 — 生产环境务必修改为随机字符串（至少32字符）
# 生成命令: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-THIS-TO-A-RANDOM-SECRET-KEY-AT-LEAST-32-CHARS

# 上传文件大小上限（字节，默认 1GB）
MAX_CONTENT_LENGTH=1073741824

# 服务监听（gunicorn 监听本地，由 nginx 反向代理）
HOST=127.0.0.1
PORT=8000

# 调试模式（生产环境必须 false）
FLASK_DEBUG=false

# external 文件默认过期天数（到期后 os.rename 到 archive）
EXTERNAL_EXPIRY_DAYS=30

# ============================================================
# AD/LDAP 配置（PSF 阶段设 false，用本地用户；PMF 阶段接入）
# ============================================================
AD_ENABLED=false
AD_HOST=dc01.company.com
AD_BASE_DN=DC=company,DC=com
AD_BIND_DN=CN=svc_ldap,OU=Service,DC=company,DC=com
AD_BIND_PASSWORD=your-password
