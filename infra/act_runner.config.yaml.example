log:
  level: info
runner:
  file: /opt/securetrans/.runner
  capacity: 1
  timeout: 3h
  insecure: true
container:
  # 注：act_runner 忽略 --network/--net（网络由 runner 统一管理，每个 job 独立 bridge 网络）
  # 容器访问 Gitea 经 WSL 网关 IP（见 infra/ci_test.sh：/proc/net/route 解析默认网关）
  privileged: false
host:
  workdir_parent: /opt/securetrans/workspace
