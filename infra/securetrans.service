[Unit]
Description=SecureTrans File Ferry Service (Flask + Gunicorn)
After=network.target remote-fs.target nss-lookup.target
Wants=network.target

[Service]
Type=simple
User=securetrans
Group=securetrans
WorkingDirectory=/opt/securetrans
EnvironmentFile=/opt/securetrans/.env
ExecStart=/opt/securetrans/venv/bin/gunicorn \
    -w 2 \
    -b 127.0.0.1:8000 \
    -t 300 \
    --access-logfile /opt/securetrans/data/gunicorn-access.log \
    --error-logfile /opt/securetrans/data/gunicorn-error.log \
    app:app
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

# 基础加固（无需 mount namespace，容器/真机通用）
NoNewPrivileges=true
# 说明：曾配置 PrivateTmp=true / ProtectSystem=strict / ReadWritePaths=，
# 这些指令需创建 mount namespace，在部分环境（容器、特定虚拟化/挂载组合）
# 下启动报 status=226/NAMESPACE。默认移除以保证可部署性；
# 如需完整加固，真机验证兼容后可自行加回。

[Install]
WantedBy=multi-user.target
