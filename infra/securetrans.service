[Unit]
Description=SecureTrans File Ferry Service (Flask + Gunicorn)
After=network.target remote-fs.target nss-lookup.target
Wants=network.target

[Service]
Type=simple
User=securetrans
Group=securetrans
WorkingDirectory=/opt/securetrans/src
EnvironmentFile=/opt/securetrans/.env
ExecStart=/opt/securetrans/venv/bin/gunicorn \
    -w 2 \
    -b ${HOST}:${PORT} \
    -t 300 \
    --access-logfile /opt/securetrans/data/gunicorn-access.log \
    --error-logfile /opt/securetrans/data/gunicorn-error.log \
    app:app
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

# 安全加固（mount namespace，已实测兼容 systemd 239/257）
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# __NAS_ROOT__ 由 deploy.sh 按 NAS_ROOT 存在性渲染（不存在则仅保留 /opt/securetrans）
# 注：systemd 239（RHEL8/Rocky8）对 ReadWritePaths 中不存在的路径启动报 226/NAMESPACE，
#     deploy.sh 已做存在性检查；NAS 挂载后重跑部署或手工 daemon-reload 更新。
ReadWritePaths=__RW_PATHS__

[Install]
WantedBy=multi-user.target
