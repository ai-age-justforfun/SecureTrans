[Unit]
Description=SecureTrans File Ferry Service (Flask + Gunicorn)
After=network.target remote-fs.target nss-lookup.target
Wants=network.target

[Service]
Type=simple
User=securetrans
Group=securetrans
WorkingDirectory=/opt/securetrans
EnvironmentFile=/opt/securetrans/.env
ExecStart=/opt/securetrans/venv/bin/gunicorn \
    -w 2 \
    -b 127.0.0.1:8000 \
    -t 300 \
    --access-logfile /opt/securetrans/data/gunicorn-access.log \
    --error-logfile /opt/securetrans/data/gunicorn-error.log \
    app:app
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# __NAS_ROOT__ 由 deploy.sh 按 .env 的 NAS_ROOT 渲染
ReadWritePaths=/opt/securetrans __NAS_ROOT__

[Install]
WantedBy=multi-user.target
