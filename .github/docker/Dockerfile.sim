# SecureTrans CD 仿真镜像（在线安装依赖，与生产 wheelhouse 离线包同源 requirements.txt）
# 用途：GitHub Actions self-hosted runner 本地 Docker 仿真部署（端口 18000），不触碰生产。
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY infra/docker/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt && rm -rf /root/.cache/pip

COPY src/ /app/src/

ENV PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["gunicorn", "--chdir", "/app/src", "--bind", "0.0.0.0:8000", "-w", "1", "--threads", "8", "app:app"]
